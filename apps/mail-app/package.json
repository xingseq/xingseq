{
  "name": "@xingseq/mail-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "L4 应用：邮件网关 + 邮件 CLI（收发邮件、常驻监听）",
  "main": "src/index.js",
  "bin": {
    "mail-app": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node src/cli.mjs gateway",
    "gateway": "node src/cli.mjs gateway",
    "gateway:dry": "node src/cli.mjs gateway --dry",
    "gateway:mock": "node src/cli.mjs gateway --mock",
    "send": "node src/cli.mjs send",
    "send-test": "node src/cli.mjs send-test",
    "once": "node src/cli.mjs once",
    "test": "node src/cli.mjs once --dry 帮我查一下时间"
  },
  "dependencies": {
    "@xingseq/shared-utils": "*",
    "@xingseq/config-core": "*",
    "@xingseq/llm-core": "*",
    "@xingseq/tool-registry": "*",
    "@xingseq/chat-core": "*",
    "nodemailer": "^9.0.1"
  },
  "xingseq": {
    "stage": 4,
    "status": "ready",
    "features": [
      "mail gateway (IMAP poll + SMTP reply)",
      "send email CLI",
      "virtual mailbox (mock/dry testing)",
      "AI-powered auto-reply via IChatProvider"
    ]
  }
}
