{
  "name": "xingseq-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XingSeq Agent Harness monorepo: a layered framework for building, running, and orchestrating LLM agents with ReAct loop, tool registry, and multi-provider support.",
  "author": "xingseq authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingseq/xingseq.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "scaffold": "node scripts/scaffold-workspace.mjs",
    "ls:pkgs": "node -e \"const {readdirSync}=require('node:fs');for(const d of ['packages','apps'])for(const n of readdirSync(d)){try{console.log(d+'/'+n)}catch{}}\""
  },
  "dependencies": {
    "imap": "^0.8.19",
    "mailparser": "^3.9.11",
    "nodemailer": "^9.0.1"
  }
}
