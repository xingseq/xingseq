# XingSeq 环境变量示例
# 复制本文件为 .env 后填入真实值，即可运行 chat-app / workspace-app / mail-app 等应用。

# ==================== LLM API Key（至少填一个） ====================
# 优先级：环境变量 > 应用内模型配置文件
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DOUBAO_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==================== 代理（可选） ====================
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=http://127.0.0.1:7890

# ==================== 应用级覆盖（可选） ====================
# chat-app / workspace-app 默认 provider，可选值：chat-core / workspace-app
# XINGSEQ_PROVIDER=chat-core

# chat-app 默认挂载工作区路径（绝对路径）
# CHAT_APP_WORKSPACE=/Users/ws/workspaces/chat

# workspace-app 默认挂载路径与名称
# WORKSPACE_APP_PATH=/Users/ws/workspaces/default
# WORKSPACE_APP_WORKSPACE=default

# 用户数据根目录（默认会自动创建）
# NAJIE_USER_DATA_PATH=/Users/ws/.xingseq

# ==================== 端口（可选） ====================
# chat-app HTTP+SSE 服务端口
# PORT=3001
# workspace-app HTTP+SSE 服务端口
# PORT=3002
